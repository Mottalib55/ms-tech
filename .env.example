# Socle (obligatoire)
DATABASE_URL=postgresql://user:password@host:5432/mstech
NEXTAUTH_URL=https://votre-domaine
NEXTAUTH_SECRET=            # openssl rand -base64 32
ENCRYPTION_KEY=             # openssl rand -hex 32 (ne jamais changer : déchiffre les accès bancaires)
CRON_SECRET=                # openssl rand -hex 32

# Limitation de débit, indispensable en production (sinon limite par instance)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# E-mails (mot de passe oublié)
RESEND_API_KEY=
MAIL_FROM=

# Agrégateurs (console de chaque fournisseur). Sans clés : « Bientôt disponible ».
POWENS_DOMAIN=
POWENS_CLIENT_ID=
POWENS_CLIENT_SECRET=
POWENS_WEBHOOK_SECRET=
SALTEDGE_APP_ID=
SALTEDGE_SECRET=
SALTEDGE_PRIVATE_KEY=
SALTEDGE_PUBLIC_KEY=
LEAN_APP_TOKEN=
LEAN_CLIENT_ID=
LEAN_CLIENT_SECRET=
LEAN_WEBHOOK_SECRET=
LEAN_BASE_URL=

# Interactive Brokers : aucun compte à créer, à activer après contrôle d'un vrai relevé
IBKR_FLEX_ENABLED=

# Banque de démonstration pour tous les comptes (jamais en production)
ENABLE_SANDBOX=

# Facultatif
COINGECKO_API_KEY=
NEXT_PUBLIC_CONTACT_EMAIL=
